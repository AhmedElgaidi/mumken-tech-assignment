{
  "name": "mumken-tech-assignment",
  "version": "1.0.0",
  "description": "Data Ingestion and Classification Service",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:migrate:status": "sequelize-cli db:migrate:status",
    "db:migration:generate": "sequelize-cli migration:generate --name",
    "lint": "eslint . --max-warnings=0",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" eslint.config.mjs",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" eslint.config.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest --config test/jest-unit.config.js",
    "test:integration": "jest --config test/jest-integration.config.js --runInBand",
    "test:e2e": "jest --config test/jest-e2e.config.js --runInBand",
    "test:all": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm test:integration && pnpm test:e2e"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.8",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.8",
    "@nestjs/platform-express": "^11.2.8",
    "@nestjs/sequelize": "^11.0.1",
    "@nestjs/terminus": "^11.1.1",
    "bullmq": "^6.5.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "express": "^5.2.1",
    "ioredis": "^6.0.0",
    "nestjs-pino": "^5.3.1",
    "pg": "^8.23.1",
    "pg-hstore": "^2.3.4",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sequelize": "^6.37.8",
    "sequelize-cli": "^6.6.5",
    "sequelize-typescript": "^2.1.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.8",
    "@testcontainers/postgresql": "^12.2.1",
    "@testcontainers/redis": "^12.2.1",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "@types/validator": "^13.15.10",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-check-file": "^3.3.2",
    "jest": "^29.7.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "testcontainers": "^12.2.1",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.72.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "cpu-features",
      "ssh2",
      "msgpackr-extract",
      "protobufjs"
    ]
  }
}
