# Copy to .env for local development (`pnpm start:dev`, `pnpm db:migrate`). docker compose does not need it.
# Only values that change between deployments live here; tuning values (timeouts, limits,
# queue names) are in code: src/infrastructure/constants/settings/app-settings.constant.ts.

# Runtime mode (also sets the log level): local | development | staging | production | test.
NODE_ENV=local

# Port the HTTP API listens on.
PORT=3000

# PostgreSQL connection string for the app and the migrations.
DATABASE_URL=postgresql://app:app@localhost:5432/ingestion

# Redis connection string for the BullMQ classification queue.
REDIS_URL=redis://localhost:6379

# Shared secret clients send in the X-API-Key header; leave empty to turn the check off.
API_KEY=
